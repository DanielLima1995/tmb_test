# Proxy usado pelo servidor Vite em desenvolvimento.
VITE_API_PROXY_TARGET=http://localhost:5161

# URL do hub SignalR. O caminho relativo funciona com o proxy local e o Nginx do container.
VITE_PEDIDOS_HUB_URL=/hubs/pedidos

# Destino da API visto de dentro do container.
# Para API rodando no host, use host.docker.internal.
API_PROXY_TARGET=http://host.docker.internal:5161
